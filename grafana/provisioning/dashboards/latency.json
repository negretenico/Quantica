{
  "title": "Latency",
  "uid": "quantica-latency",
  "schemaVersion": 38,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "WSS Receive Latency p50/p95/p99",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "quantica_stage_wss_receive_seconds{quantile=\"0.5\"}",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "quantica_stage_wss_receive_seconds{quantile=\"0.95\"}",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "quantica_stage_wss_receive_seconds{quantile=\"0.99\"}",
          "legendFormat": "p99"
        }
      ]
    },
