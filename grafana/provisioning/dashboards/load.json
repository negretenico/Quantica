      "type": "timeseries",
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(markettrade_decisions_total[1m])",
          "legendFormat": "{{symbol}} / {{action}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Outcome Records/sec",
